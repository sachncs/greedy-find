---
import Logo from './icons/Logo.astro';
import Sun from './icons/Sun.astro';
import ArrowRight from './icons/ArrowRight.astro';
---
<header class="nav" data-nav data-scrolled="false">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="greedy-find home">
      <Logo size={28} />
      <span>greedy-find</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="#overview" class="nav__link">Overview</a>
      <a href="#features" class="nav__link">Features</a>
      <a href="#architecture" class="nav__link">Architecture</a>
      <a href="#cli" class="nav__link">CLI</a>
      <a href="#roadmap" class="nav__link">Roadmap</a>
    </nav>

    <div class="nav__actions">
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme">
        <Sun class="icon icon--md" />
      </button>
      <a
        class="btn btn--ghost btn--icon"
        href="https://github.com/sachncs/greedy-find"
        aria-label="GitHub repository"
        target="_blank"
        rel="noopener"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.74 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.2-1.49 3.16-1.18 3.16-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.26 5.65.41.36.78 1.06.78 2.13v3.16c0 .31.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
          />
        </svg>
      </a>
      <a class="btn btn--primary" href="#install">
        Get started <ArrowRight class="icon icon--sm" />
      </a>
    </div>
  </div>
</header>