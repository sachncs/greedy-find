---
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className = 'icon' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M12 3v18M3 12h18" />
  <circle cx="12" cy="12" r="9" />
  <path d="M12 7v5l3 2" />
</svg>