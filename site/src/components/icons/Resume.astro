---
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className = 'icon' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1.06 6.7 2.82" />
  <path d="M21 3v5h-5" />
</svg>