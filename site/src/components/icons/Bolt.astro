---
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className = 'icon' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
</svg>