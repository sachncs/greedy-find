---
import Logo from './icons/Logo.astro';
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="nav__brand" aria-label="greedy-find home" style="color: var(--text);">
          <Logo size={28} />
          <span>greedy-find</span>
        </a>
        <p>
          Metal-accelerated secp256k1 key discovery. A research-grade tool by
          <a href="https://github.com/sachncs" target="_blank" rel="noopener" style="color: var(--text);">sachncs</a>.
        </p>
        <p class="subtle" style="font-size: var(--fs-xs);">
          Educational and research use only.
        </p>
      </div>

      <div class="footer__col">
        <h4>Project</h4>
        <ul>
          <li><a href="https://github.com/sachncs/greedy-find" target="_blank" rel="noopener">Repository</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/LICENSE" target="_blank" rel="noopener">License (MIT)</a></li>
          <li><a href="https://github.com/sachncs/find" target="_blank" rel="noopener">CPU sibling · `find`</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Docs</h4>
        <ul>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/docs/algorithms.md" target="_blank" rel="noopener">Algorithms</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/docs/architecture.md" target="_blank" rel="noopener">Architecture</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/docs/cli.md" target="_blank" rel="noopener">CLI</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/docs/security.md" target="_blank" rel="noopener">Security</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Project</h4>
        <ul>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/DISCLAIMER.md" target="_blank" rel="noopener">Disclaimer</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/SECURITY.md" target="_blank" rel="noopener">Security policy</a></li>
          <li><a href="https://github.com/sachncs/greedy-find/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener">Code of conduct</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© 2026 sachncs · greedy-find · v0.1.0</span>
      <div class="footer__bottom-links">
        <a href="#overview">Overview</a>
        <a href="#features">Features</a>
        <a href="#cli">CLI</a>
      </div>
    </div>
  </div>
</footer>