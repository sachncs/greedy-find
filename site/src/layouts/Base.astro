---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'greedy-find — Metal-accelerated secp256k1 key discovery',
  description = 'greedyfind is a research-grade, GPU-accelerated secp256k1 key discovery tool for Apple Silicon. Multi-variant range-splitting, atomic match buffer, full host↔device pipeline.',
} = Astro.props;

const canonical = 'https://sachncs.github.io/greedy-find/';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <script is:inline>
      (function () {
        try {
          const url = new URL(window.location.href);
          const q = url.searchParams.get('theme');
          const saved = q || localStorage.getItem('gf-theme');
          const theme =
            saved === 'light' || saved === 'dark'
              ? saved
              : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch (_) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <slot />

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>